<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Инспектор данных пользователя</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #e2e8f0;
            --accent-color: #38bdf8;
            --border-color: #334155;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            line-height: 1.6;
        }
        h1 {
            text-align: center;
            color: var(--accent-color);
            margin-bottom: 30px;
        }
        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .card h2 {
            margin-top: 0;
            color: var(--accent-color);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
            font-size: 1.2rem;
        }
        .data-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            border-bottom: 1px dashed #334155;
            padding-bottom: 4px;
        }
        .data-label {
            font-weight: bold;
            color: #94a3b8;
        }
        .data-value {
            text-align: right;
            word-break: break-all;
            max-width: 60%;
        }
        button {
            background: var(--accent-color);
            color: #0f172a;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            width: 100%;
            margin-top: 10px;
            transition: background 0.3s;
        }
        button:hover {
            background: #0ea5e9;
        }
    </style>
</head>
<body>

    <h1>Анализ данных браузера и сети</h1>
    
    <div class="container">
        <div class="card" id="network-card">
            <h2>🌐 Сеть и Провайдер</h2>
            <div id="network-data">Загрузка данных...</div>
        </div>

        <div class="card" id="device-card">
            <h2>💻 Устройство и ОС</h2>
            <div id="device-data"></div>
        </div>

        <div class="card" id="screen-card">
            <h2>🖥️ Характеристики экрана</h2>
            <div id="screen-data"></div>
        </div>

        <div class="card" id="gpu-card">
            <h2>🎮 Видеокарта (WebGL)</h2>
            <div id="gpu-data"></div>
        </div>

        <div class="card" id="time-card">
            <h2>⏱️ Время и Локаль</h2>
            <div id="time-data"></div>
        </div>

        <div class="card" id="geo-card">
            <h2>📍 Точная Геолокация</h2>
            <p style="font-size: 0.9em; color: #94a3b8;">Требует разрешения пользователя.</p>
            <button onclick="getExactLocation()">Запросить доступ к геоданным</button>
            <div id="geo-data" style="margin-top: 15px;"></div>
        </div>
    </div>

    <script>
        // Вспомогательная функция для форматирования строк
        function createRow(label, value) {
            return `<div class="data-row">
                        <span class="data-label">${label}:</span>
                        <span class="data-value">${value || 'Недоступно'}</span>
                    </div>`;
        }

        // 1. Устройство и ОС
        function getDeviceInfo() {
            const nav = window.navigator;
            let html = '';
            html += createRow('User Agent', nav.userAgent);
            html += createRow('Платформа', nav.platform);
            html += createRow('Ядра процессора', nav.hardwareConcurrency);
            html += createRow('ОЗУ (ГБ)', nav.deviceMemory ? `~${nav.deviceMemory} ГБ` : 'Скрыто браузером');
            html += createRow('Cookies включены', nav.cookieEnabled ? 'Да' : 'Нет');
            html += createRow('Do Not Track', nav.doNotTrack === "1" ? 'Включен' : 'Отключен/Не задан');
            document.getElementById('device-data').innerHTML = html;
        }

        // 2. Экран
        function getScreenInfo() {
            const scr = window.screen;
            let html = '';
            html += createRow('Разрешение', `${scr.width} x ${scr.height}`);
            html += createRow('Доступная область', `${scr.availWidth} x ${scr.availHeight}`);
            html += createRow('Глубина цвета', `${scr.colorDepth} бит`);
            html += createRow('Pixel Ratio', window.devicePixelRatio);
            html += createRow('Размер окна браузера', `${window.innerWidth} x ${window.innerHeight}`);
            document.getElementById('screen-data').innerHTML = html;
        }

        // 3. Время и Язык
        function getTimeInfo() {
            const date = new Date();
            let html = '';
            html += createRow('Локальное время', date.toLocaleString());
            html += createRow('Часовой пояс', Intl.DateTimeFormat().resolvedOptions().timeZone);
            html += createRow('Смещение UTC', `${-date.getTimezoneOffset() / 60} часов`);
            html += createRow('Язык браузера', navigator.language);
            html += createRow('Предпочитаемые языки', navigator.languages.join(', '));
            document.getElementById('time-data').innerHTML = html;
        }

        // 4. Графика (WebGL Fingerprint)
        function getGPUInfo() {
            const canvas = document.createElement('canvas');
            let gl;
            let renderer = 'Неизвестно';
            let vendor = 'Неизвестно';
            
            try {
                gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
                if (gl) {
                    const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
                    if (debugInfo) {
                        vendor = gl.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL);
                        renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
                    }
                }
            } catch (e) {
                renderer = 'Ошибка получения данных';
            }

            let html = '';
            html += createRow('GPU Vendor', vendor);
            html += createRow('GPU Renderer', renderer);
            document.getElementById('gpu-data').innerHTML = html;
        }

        // 5. Сеть и IP (С улучшенной системой запасных API)
        async function getNetworkInfo() {
            const nav = window.navigator;
            let html = '';
            
            if (nav.connection) {
                html += createRow('Эффективный тип', nav.connection.effectiveType);
                html += createRow('Скорость (Мбит/с)', nav.connection.downlink);
                html += createRow('Задержка (RTT)', `${nav.connection.rtt} мс`);
            }

            const apis = [
                'https://ipapi.co/json/',
                'https://ipinfo.io/json',
                'https://api.ipify.org?format=json'
            ];

            let ipData = null;
            let currentApi = '';

            for (let url of apis) {
                try {
                    const response = await fetch(url);
                    if (response.ok) {
                        ipData = await response.json();
                        currentApi = url;
                        break;
                    }
                } catch (error) {
                    console.warn(`[Network] Заблокирован доступ к: ${url}`);
                }
            }

            if (ipData) {
                const ip = ipData.ip || 'Неизвестно';
                html += createRow('IP-адрес', ip);

                if (currentApi !== 'https://api.ipify.org?format=json') {
                    const org = ipData.org || ipData.isp || 'Неизвестно';
                    const country = ipData.country_name || ipData.country || 'Неизвестно';
                    const city = ipData.city || 'Неизвестно';
                    
                    html += createRow('Провайдер (ISP)', org);
                    html += createRow('Страна', country);
                    html += createRow('Город', city);
                } else {
                    html += createRow('Доп. данные', 'Скрыты блокировщиком (доступен только IP)');
                }
            } else {
                html += createRow('IP-адрес', '<span style="color:#f87171;">Блокируется расширением (AdBlock/VPN)</span>');
            }

            document.getElementById('network-data').innerHTML = html;
        }

        // 6. Точная геолокация с системой каскадного переключения
        function getExactLocation() {
            const geoDiv = document.getElementById('geo-data');
            geoDiv.innerHTML = "<i style='color: #94a3b8;'>Попытка 1: Поиск спутников GPS...</i>";

            if (!navigator.geolocation) {
                geoDiv.innerHTML = createRow('Ошибка', 'Геолокация не поддерживается вашим браузером');
                return;
            }

            const highAccuracyOptions = { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 };
            const lowAccuracyOptions = { enableHighAccuracy: false, timeout: 5000, maximumAge: 60000 };

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    showGeoData(position, "GPS / Высокая точность");
                },
                (error) => {
                    console.warn("GPS не ответил за 5 сек. Переключаемся на сети...");
                    geoDiv.innerHTML = "<i style='color: #94a3b8;'>Попытка 2: GPS недоступен, определяем по сетям...</i>";
                    
                    navigator.geolocation.getCurrentPosition(
                        (position) => {
                            showGeoData(position, "Wi-Fi, IP / Базовая точность");
                        },
                        (errorLow) => {
                            let msg = '';
                            switch(errorLow.code) {
                                case errorLow.PERMISSION_DENIED: msg = "Доступ заблокирован пользователем."; break;
                                case errorLow.POSITION_UNAVAILABLE: msg = "Координаты недоступны."; break;
                                case errorLow.TIMEOUT: msg = "Превышено время ожидания."; break;
                                default: msg = "Неизвестная ошибка геоданных."; break;
                            }
                            geoDiv.innerHTML = createRow('Ошибка', `<span style="color:#f87171;">${msg}</span>`);
                        },
                        lowAccuracyOptions
                    );
                },
                highAccuracyOptions
            );
        }

        // Вспомогательная функция для отрисовки успешного результата геолокации
        function showGeoData(position, methodUsed) {
            const geoDiv = document.getElementById('geo-data');
            let html = '';
            html += createRow('Метод определения', methodUsed);
            html += createRow('Широта', position.coords.latitude);
            html += createRow('Долгота', position.coords.longitude);
            html += createRow('Точность', `± ${Math.round(position.coords.accuracy)} м`);
            
            // Формируем корректную ссылку на карты
            const mapsLink = `https://www.google.com/maps?q=${position.coords.latitude},${position.coords.longitude}`;
            html += `<div style="margin-top: 15px; text-align: center;">
                        <a href="${mapsLink}" target="_blank" style="color: var(--accent-color); text-decoration: none; border-bottom: 1px dashed var(--accent-color); padding-bottom: 2px;">
                            📍 Открыть на Google Maps
                        </a>
                     </div>`;
            geoDiv.innerHTML = html;
        }

        // Запуск сбора данных при открытии страницы
        window.onload = () => {
            getDeviceInfo();
            getScreenInfo();
            getTimeInfo();
            getGPUInfo();
            getNetworkInfo();
        };
    </script>
</body>
</html>
